# Copiar a .env (`cp .env.example .env`). Nunca commitear .env.

# --- App
APP_ENVIRONMENT=local
APP_DEBUG=false
APP_LOG_LEVEL=INFO

# Fuera de docker compose (uv run ...). Dentro de compose se sobreescribe para apuntar a `db`.
APP_DATABASE_URL=postgresql+asyncpg://app:app@localhost:5432/app

# --- Auth (generar con: python -c "import secrets; print(secrets.token_urlsafe(64))")
APP_JWT_SECRET_KEY=
APP_JWT_ACCESS_TOKEN_TTL_MINUTES=15
APP_JWT_REFRESH_TOKEN_TTL_DAYS=7

# --- Disparo de robots
APP_TRIGGER_TIMEOUT_SECONDS=10
# Lista JSON de hosts permitidos para trigger_url (mitiga SSRF)
APP_TRIGGER_ALLOWED_HOSTS=[]

# --- docker compose
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=app
API_PORT=8000
DB_PORT=5432
